{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "heatmap",
      "name": "Heatmap",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Per-bot drilldown: tick/fill latency heatmaps, order intent breakdown, position notional, PnL, and signal staleness.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"custom": {"scaleDistribution": {"type": "log", "log": 2}}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "calculate": false,
        "yAxis": {"unit": "s", "decimals": 2},
        "color": {"mode": "scheme", "scheme": "Oranges"}
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (le) (rate(bot_tick_latency_seconds_bucket{bot_id=\"$bot_id\"}[5m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "title": "Tick Latency Heatmap — $bot_id",
      "type": "heatmap"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"custom": {"scaleDistribution": {"type": "log", "log": 2}}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {
        "calculate": false,
        "yAxis": {"unit": "s", "decimals": 2},
        "color": {"mode": "scheme", "scheme": "Blues"}
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (le) (rate(order_fill_latency_seconds_bucket{bot_id=\"$bot_id\"}[5m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "title": "Fill Latency Heatmap — $bot_id",
      "type": "heatmap"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"fillOpacity": 20, "stacking": {"mode": "normal"}}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right"}},
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(order_intent_total{bot_id=\"$bot_id\",result=\"accepted\"}[5m])",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(order_intent_total{bot_id=\"$bot_id\",result=\"rejected\"}[5m])",
          "legendFormat": "rejected",
          "refId": "B"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(order_intent_total{bot_id=\"$bot_id\",result=\"risk_blocked\"}[5m])",
          "legendFormat": "risk_blocked",
          "refId": "C"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(order_intent_total{bot_id=\"$bot_id\",result=\"kill_switch\"}[5m])",
          "legendFormat": "kill_switch",
          "refId": "D"
        }
      ],
      "title": "Order Intent Breakdown (stacked area) — $bot_id",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1},
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "position_notional_usd{bot_id=\"$bot_id\"}",
          "legendFormat": "position notional",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "pnl_realized_usd{bot_id=\"$bot_id\"}",
          "legendFormat": "pnl realized",
          "refId": "B"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "pnl_unrealized_usd{bot_id=\"$bot_id\"}",
          "legendFormat": "pnl unrealized",
          "refId": "C"
        }
      ],
      "title": "Position Notional + PnL — $bot_id",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 60},
              {"color": "red", "value": 120}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "signal_staleness_seconds",
          "legendFormat": "{{signal}}",
          "refId": "A"
        }
      ],
      "title": "Signal Staleness (all signals — not bot-specific)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "tags": ["polymarket", "bots", "drilldown"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(bot_tick_latency_seconds_count, bot_id)",
        "hide": 0,
        "includeAll": false,
        "label": "Bot ID",
        "multi": false,
        "name": "bot_id",
        "query": {
          "query": "label_values(bot_tick_latency_seconds_count, bot_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "UTC",
  "title": "Per-Bot Drilldown",
  "uid": "polymarket-per-bot",
  "version": 1
}
