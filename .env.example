# Non-secret configuration defaults — copy to .env and edit for your environment.
# POSTGRES_PASSWORD lives in secrets/infra.enc.yaml — NEVER put it here.

LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bidder
POSTGRES_USER=bidder

MANAGER_HEARTBEAT_SEC=30

# Default mode for all bots unless overridden per-bot in config/bots.yaml.
# Never set to "live" here — live requires the three-lock protocol (see CLAUDE.md).
BOT_MODE_DEFAULT=paper

# Read-only dashboard_reader Postgres role credentials (see
# .claude/rules/06b-dashboard.md invariant 8). Falls back to POSTGRES_USER
# with a warning log if unset — set these for a real deployment.
DASHBOARD_PG_USER=
DASHBOARD_PG_PASSWORD=

# Polymarket adapter secrets live in secrets/exchanges.enc.yaml under the
# `polymarket` key — NEVER put them here. Notably, for live trading, set
# `polymarket.polygon_rpc_url` there to an authenticated Polygon RPC provider
# URL (e.g. Alchemy, Infura, Ankr — all have free tiers). The adapter's
# default (`https://polygon-rpc.com`) is a free public RPC that periodically
# rejects bot traffic with HTTP 401, degrading pre-trade wallet safety checks.
# See .claude/rules/05-exchanges.md § Wallet safety checks.
