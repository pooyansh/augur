# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Claude Code local settings (per-user, never shared) ---
.claude/settings.local.json

# --- Env / local config ---
.env
.env.*
!.env.example

# --- Secrets: plaintext NEVER allowed; encrypted .enc.yaml IS committed ---
# Refuse anything that could be a decrypted secret.
secrets/*.yaml
!secrets/*.enc.yaml
!secrets/.sops.yaml

# Disposable wallet keys / age keys must never be committed.
**/keys.txt
**/*.age
**/*.privkey
**/wallet.json
**/keystore/

# --- Scout (Phase 1) ---
# Captured run outputs may contain wallet addresses, headers, or balances.
# Keep them local; promote curated snippets into learnings/ deliberately.
scout/runs/
scout/.cache/
scout/.env

# --- ML sidetrack ---
ml/artifacts/
ml/.cache/
*.parquet
*.joblib
*.onnx

# --- Database / logs ---
*.sqlite
*.sqlite3
*.db
*.log
logs/

# --- Docker volumes (when generated locally) ---
docker/volumes/
